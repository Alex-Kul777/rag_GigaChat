# GigaChat Configuration
# Get your API key from: https://lk.sbercloud.ru/fusion/auth/login
GIGACHAT_API_KEY=your-api-key-here

# (Optional) RAG Configuration
# RAG_MODE=retrieval  # or 'generation' or 'hybrid'
# CHUNK_SIZE=512
# CHUNK_OVERLAP=100
# TOP_K=5
# TEMPERATURE=0.7

# (Optional) Vector Store Configuration
# FAISS_INDEX_PATH=data/vectorstore/index.faiss
# EMBEDDINGS_MODEL=gigachat

# (Optional) Logging
# LOG_LEVEL=INFO
# DEBUG=false

# (Optional) Debug & Process Mining
# RAG_DEBUG=false
# RAG_LOG_LEVEL=INFO

# (Optional) GPU Configuration
# CUDA_VISIBLE_DEVICES=0
# GPU_ENABLED=true
