
// Для сложной отладки и анализа
//"model": "claude-3-opus-20240229"

// Для быстрых правок и простых задач  
//"model": "claude-3-haiku-20240307"

// Для повседневной разработки (рекомендуется)
//"model": "claude-3-5-sonnet-20241022"

{
  "projects": {
    "rag_GigaChat": {
      "path": "/home/kap/projects/rag_GigaChat",
      "rules": "CLAUDE.md",
      "commands": ".claude/commands",
      "auto_approve": true,
      "auto_approve_scope": "project_only",
      "ask_outside_project": true
    }
  },
  "defaults": {
    "model": "claude-3-sonnet-20240229",
    "temperature": 0.3,
    "max_tokens": 8000,
    "top_p": 0.9,
    "top_k": 40    
  },
  "settings": {
//    "auto_approve": false,
//    "verbose": true,
    "save_history": true,
    "history_dir": "~/.claude/history"
  }

  "permissions": {
    "read_operations": ["cat", "head", "tail", "less", "grep", "awk", "find", "ls"],
    "write_operations": ["echo", "sed", "awk", "python3", "git add", "git commit"],
    "dangerous_operations": ["rm", "sudo", "chmod", "mv", "cp", "git push"],
    "auto_approve_patterns": [
      "*.py",
      "*.md",
      "*.txt",
      "*.json",
      "*.yaml",
      "*.yml",
      "tests/*",
      "docs/*",
      "src/*"
    ],
    "ask_always_patterns": [
      ".env",
      "config.py",
      "requirements.txt",
      "CLAUDE.md",
      ".git/config"
    ]
  },
  "safety": {
    "check_project_boundary": true,
    "warn_external_access": true,
    "block_system_commands": true,
    "max_file_size_mb": 10
  }
}