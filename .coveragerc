[run]
source =
    rag_core
    token_counter
    config
omit =
    tests/*
    .venv/*
    */site-packages/*
    */__pycache__/*
    */test_*
    */conftest.py
    evaluator.py
    excel_reporter.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    pass
show_missing = True
precision = 2
fail_under = 55

[html]
directory = htmlcov
